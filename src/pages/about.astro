---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { renderMarkdown } from '../lib/richText';

const siteEntries = await getCollection('site');
const a = siteEntries.find(e => e.id === 'about.md')!.data;
const heroBgClass   = a.heroBg       ? `bg-${a.heroBg}`       : '';
const introBgClass  = a.aboutIntroBg ? `bg-${a.aboutIntroBg}` : '';
const craftBgClass  = a.aboutCraftBg ? `bg-${a.aboutCraftBg}` : '';
const valuesBgClass = a.aboutValuesBg? `bg-${a.aboutValuesBg}`: '';
const ctaBgClass    = a.aboutCtaBg   ? `bg-${a.aboutCtaBg}`   : '';

// introParagraphs is the canonical field name
const paragraphs = a.introParagraphs ?? [];
const steps = a.processSteps ?? [];
const values = a.valuesParagraphs ?? [];
---

<Layout
  title="About"
  description="Learn about Amanda and the story behind Bartram Studio — handcrafted coastal art from St. Johns, Florida."
>

  <section class={`page-hero ${heroBgClass}`}>
    <div class="container">
      <p class="page-hero__eyebrow">{a.pageEyebrow}</p>
      <h1>{a.pageTitle}</h1>
      <div class="rich-text" set:html={renderMarkdown(a.pageIntro)} />
    </div>
  </section>

  <!-- Intro -->
  <section class={`section ${introBgClass}`}>
    <div class="container about-intro">
      <div class="about-intro__image">
        <div class="about-frame">
          {a.profileImage ? (
            <img
              src={a.profileImage}
              alt="Amanda, maker behind Bartram Studio"
              class="about-portrait"
            />
          ) : (
            <div class="about-img-placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span>A photo of Amanda</span>
            </div>
          )}
        </div>
        <div class="about-frame-accent"></div>
      </div>

      <div class="about-intro__text">
        <p class="section-eyebrow">{a.introEyebrow}</p>
        <h2>{a.introTitle}</h2>
        {paragraphs.map(para => <div class="rich-text" set:html={renderMarkdown(para)} />)}
      </div>
    </div>
  </section>

  <!-- What I make -->
  <section class={`section craft-section ${craftBgClass}`}>
    <div class="container">
      <div class="section-head" style="text-align:center; max-width: 560px; margin-inline: auto; margin-bottom: 3rem;">
        <p class="section-eyebrow">{a.craftEyebrow}</p>
        <h2>{a.craftTitle}</h2>
        <div class="rich-text" set:html={renderMarkdown(a.craftText)} />
      </div>

      <div class="process-grid">
        {steps.map((step, i) => (
          <div class="process-step">
            <div class="process-step__number">{String(i + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <div class="rich-text" set:html={renderMarkdown(step.body)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class={`section values-section ${valuesBgClass}`}>
    <div class="container values-inner">
      <div class="values-text">
        <p class="section-eyebrow">{a.valuesEyebrow}</p>
        <h2>{a.valuesTitle}</h2>
        {values.map(para => <div class="rich-text" set:html={renderMarkdown(para)} />)}
        <a href="/products" class="btn btn--outline" style="margin-top: 1.5rem;">Browse the Shop</a>
      </div>
      <div class="values-quote">
        <blockquote>
          <div class="rich-text quote-text" set:html={renderMarkdown(a.quoteText)} />
          <cite>{a.quoteCitation}</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class={`section--sm contact-strip ${ctaBgClass}`}>
    <div class="container">
      <div class="contact-strip__inner">
        <div>
          <h3>{a.contactCtaTitle}</h3>
          <div class="rich-text" set:html={renderMarkdown(a.contactCtaText)} />
        </div>
        <a href="/contact" class="btn btn--coral">{a.contactCtaButtonText}</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* Base .rich-text (p/strong/em/ul/ol/li/a) styling is centralized in
   src/styles/global.css — see the "Rich Text" section there for why. Only
   this page's own contextual rich-text overrides live below
   (.quote-text, .contact-strip). */

.section-eyebrow {
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--secondary-text);
  margin-bottom: 0.6rem;
  max-width: none;
}

/* ── Intro ── */
.about-intro {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 5rem;
  align-items: start;
}

.about-intro__image {
  position: relative;
  padding-bottom: 1.5rem;
  padding-right: 1.5rem;
}

.about-frame {
  position: relative;
  z-index: 1;
  width: 100%;
  aspect-ratio: 3/4;
  background: var(--sand);
  overflow: hidden;
}

.about-portrait {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.about-frame-accent {
  position: absolute;
  bottom: 0;
  right: 0;
  width: calc(100% - 20px);
  height: calc(100% - 20px);
  border: 2px solid var(--sand-dark);
  z-index: 0;
}

.about-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  color: var(--driftwood);
  opacity: 0.4;
}

.about-img-placeholder svg {
  width: 56px;
  height: 56px;
}

.about-img-placeholder span {
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.about-intro__text {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.about-intro__text h2 {
  color: var(--driftwood-dk);
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  margin-top: 0.5rem;
  margin-bottom: 0.5rem;
}

/* ── Process ── */
.craft-section {
  background: var(--sand);
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2.5rem;
}

.process-step {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.process-step__number {
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: 300;
  color: var(--tide-light);
  line-height: 1;
  letter-spacing: -0.02em;
}

.process-step h3 {
  font-size: 1.3rem;
  color: var(--driftwood-dk);
}

.process-step p {
  font-size: 0.9rem;
  line-height: 1.7;
}

/* ── Values ── */
.values-inner {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 5rem;
  align-items: center;
}

.values-text {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.values-text h2 {
  color: var(--driftwood-dk);
  font-size: clamp(1.5rem, 2.5vw, 2.2rem);
  margin-top: 0.5rem;
}

.values-quote {
  position: relative;
}

.values-quote blockquote {
  border-left: 3px solid var(--tide-light);
  padding-left: 1.75rem;
}

/* quoteText is now Markdown-rendered and injected via set:html, so its <p>
   is not subject to Astro's scoped-style attribute — :global() is required
   here or this rule silently stops matching. */
.values-quote blockquote .quote-text :global(p) {
  font-family: var(--font-display);
  font-style: italic;
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  color: var(--driftwood-dk);
  line-height: 1.6;
  max-width: 40ch;
  margin: 0;
}

/* Quote marks moved here from literal characters in the template — the
   Markdown-rendered text already supplies its own <p>, so wrapping it in
   literal "…" in the template would sit awkwardly outside that tag. */
.quote-text :global(p:first-child)::before { content: '\201C'; }
.quote-text :global(p:last-child)::after { content: '\201D'; }

.values-quote cite {
  display: block;
  margin-top: 1rem;
  font-size: 0.8rem;
  font-style: normal;
  color: var(--secondary-text);
  letter-spacing: 0.05em;
}

/* ── Contact Strip ── */
.contact-strip {
  background: var(--tide-dark);
  color: var(--white);
  padding-block: 3rem;
}

.contact-strip__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}

.contact-strip h3 {
  font-size: 1.5rem;
  color: var(--white);
  margin-bottom: 0.5rem;
}

/* contactCtaText is Markdown-rendered and injected via set:html, so its <p>
   is not subject to Astro's scoped-style attribute — :global() is required
   here or this rule silently stops matching (the regression this file
   previously shipped with). */
.contact-strip :global(p) {
  color: var(--tide-light);
  max-width: 55ch;
}

.contact-strip .btn--coral {
  flex-shrink: 0;
  background: var(--white);
  color: var(--tide-dark);
}

.contact-strip .btn--coral:hover {
  background: var(--sand);
}

@media (max-width: 768px) {
  .about-intro,
  .values-inner {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  /* Previously hidden entirely (display: none). The portrait now shows on
     mobile, centered and constrained well below the width it would
     otherwise stretch to as a full-width single grid column. The 3:4 ratio
     is untouched (.about-frame's own aspect-ratio: 3/4 rule, unchanged,
     still applies). width: min(...) rather than a bare max-width avoids
     any horizontal-overflow risk regardless of exact container padding.

     Desktop's padding-right: 1.5rem exists to offset .about-frame from the
     adjacent text column, revealing the .about-frame-accent decorative
     border behind it — with no adjacent column on mobile, that much
     right-side padding would just push the now-centered frame off-centre.
     Rebalancing both to a smaller, equal 0.75rem keeps the same
     bottom-and-right decorative reveal, just narrower and symmetric. */
  .about-intro__image {
    width: min(100%, 280px);
    margin-inline: auto;
    padding-right: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .contact-strip__inner { flex-direction: column; align-items: flex-start; }
}

/* ── Contact strip bg-* overrides ──────────────────────────────────────────
   When Amanda selects a light palette colour for the CTA strip, the default
   white/teal text is no longer readable. These rules adapt text to ink and
   reset the button to the standard coral style.
   Selector specificity matches .contact-strip child rules above.          */
.contact-strip.bg-soft-shell,
.contact-strip.bg-sea-glass,
.contact-strip.bg-resin-amber,
.contact-strip.bg-shell-pink,
.contact-strip.bg-driftwood {
  color: var(--ink);
}

.contact-strip.bg-soft-shell h3,
.contact-strip.bg-sea-glass  h3,
.contact-strip.bg-resin-amber h3,
.contact-strip.bg-shell-pink  h3,
.contact-strip.bg-driftwood   h3 {
  color: var(--ink);
}

.contact-strip.bg-soft-shell :global(p),
.contact-strip.bg-sea-glass  :global(p),
.contact-strip.bg-resin-amber :global(p),
.contact-strip.bg-shell-pink  :global(p),
.contact-strip.bg-driftwood   :global(p) {
  color: var(--ink);
}

.contact-strip.bg-soft-shell .btn--coral,
.contact-strip.bg-sea-glass  .btn--coral,
.contact-strip.bg-resin-amber .btn--coral,
.contact-strip.bg-shell-pink  .btn--coral,
.contact-strip.bg-driftwood   .btn--coral {
  background: var(--tide-dark);
  color: var(--white);
}

.contact-strip.bg-soft-shell .btn--coral:hover,
.contact-strip.bg-sea-glass  .btn--coral:hover,
.contact-strip.bg-resin-amber .btn--coral:hover,
.contact-strip.bg-shell-pink  .btn--coral:hover,
.contact-strip.bg-driftwood   .btn--coral:hover {
  background: var(--driftwood-dk);
}
</style>
