---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { renderMarkdown } from '../lib/richText';

// Site content
const siteEntries = await getCollection('site');
const c = siteEntries.find(e => e.id === 'contact.md')!.data;
const heroBgClass      = c.heroBg         ? `bg-${c.heroBg}`         : '';
const mainBgClass      = c.contactMainBg  ? `bg-${c.contactMainBg}`  : '';
const accentBgClass    = c.contactAccentBg? `bg-${c.contactAccentBg}`: '';
const methodsBgClass   = c.contactMethodsBg?`bg-${c.contactMethodsBg}`: '';
const faqBgClass       = c.contactFaqBg  ? `bg-${c.contactFaqBg}`   : '';

const customParas = c.customOrdersParagraphs ?? [];
const faqs = c.faqItems ?? [];
---

<Layout
  title="Contact"
  description="Get in touch with Amanda at Bartram Studio — inquire about a piece, request a custom order, or just say hello."
>

  <section class={`page-hero ${heroBgClass}`}>
    <div class="container">
      <p class="page-hero__eyebrow">{c.pageEyebrow}</p>
      <h1>{c.pageTitle}</h1>
      <div class="rich-text" set:html={renderMarkdown(c.pageIntro)} />
    </div>
  </section>

  <section class={`section ${mainBgClass}`}>
    <div class="container contact-layout">

      <!-- Form — Netlify attributes and URL-prefill behaviour unchanged -->
      <div class="contact-form-wrap">
        <h2>{c.formTitle}</h2>
        <div class="rich-text" style="margin-bottom: 2rem;" set:html={renderMarkdown(c.formIntro)} />

        <form
          class="contact-form"
          method="POST"
          action="https://formspree.io/f/xbgjzbwp"
          id="contact-form"
        >

          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name <span class="req">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Jane Smith" />
            </div>
            <div class="form-group">
              <label for="email">Email Address <span class="req">*</span></label>
              <input type="email" id="email" name="email" required placeholder="jane@example.com" />
            </div>
          </div>

          <div class="form-group">
            <label for="subject">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="What's on your mind?"
            />
          </div>

          <div class="form-group">
            <label for="interest">I'm interested in…</label>
            <select id="interest" name="interest">
              <option value="">Select an option</option>
              <option value="existing-piece">An existing piece I saw on the site</option>
              <option value="custom-order">A custom order</option>
              <option value="wholesale">Wholesale / local retail</option>
              <option value="general">Just saying hello</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message <span class="req">*</span></label>
            <textarea
              id="message"
              name="message"
              required
              placeholder="Tell me what you're looking for, or ask any questions you have…"
            ></textarea>
          </div>

          <div id="form-error" class="form-error" role="alert" hidden></div>

          <button type="submit" class="btn btn--primary btn--submit" id="contact-submit">
            <span class="btn-label">Send Message</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>

          <p class="form-note">* Required fields. I'll never share your information.</p>
        </form>

        <div id="form-success" class="form-success" role="status" tabindex="-1" hidden>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9"/></svg>
          <div>
            <p class="form-success__title">Thank you for reaching out.</p>
            <p class="form-success__body">Your message has been sent. I'll be in touch soon.</p>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="contact-sidebar">
        <div class={`sidebar-card ${methodsBgClass}`}>
          <h3>Other ways to reach me</h3>

          <div class="contact-methods">
            <div class="contact-method">
              <div class="contact-method__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <p class="contact-method__label">Email</p>
                <a href={`mailto:${c.email}`} class="contact-method__value">{c.email}</a>
              </div>
            </div>

            <div class="contact-method">
              <div class="contact-method__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </div>
              <div>
                <p class="contact-method__label">Instagram</p>
                <a href={c.instagramUrl} target="_blank" rel="noopener" class="contact-method__value">{c.instagramHandle}</a>
              </div>
            </div>

            <div class="contact-method">
              <div class="contact-method__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="contact-method__label">Location</p>
                <span class="contact-method__value">{c.location}</span>
              </div>
            </div>
          </div>
        </div>

        <div class={`sidebar-card sidebar-card--accent ${accentBgClass}`}>
          <h3>{c.customOrdersTitle}</h3>
          {customParas.map(para => <div class="rich-text" set:html={renderMarkdown(para)} />)}
          <p class="sidebar-response">Typical response time: <strong>{c.responseTime}</strong></p>
        </div>

        <div class={`sidebar-card ${faqBgClass}`}>
          <h3>Frequently Asked</h3>
          <div class="faqs">
            {faqs.map(item => (
              <details class="faq">
                <summary>{item.question}</summary>
                <div class="rich-text faq-answer" set:html={renderMarkdown(item.answer)} />
              </details>
            ))}
          </div>
        </div>

      </aside>
    </div>
  </section>

</Layout>

<script define:vars={{ contactEmail: c.email }}>
  // Pre-fill the contact form from runtime query params (?subject=&body=),
  // set by product pages' "I'm Interested" links. This must run client-side
  // because the site is statically generated (output: 'static') — there is
  // no per-visitor request at build time for Astro.url.searchParams to read.
  // Direct visits to /contact/ (no matching params) are left untouched.
  //
  // Note: because this script uses define:vars, Astro treats it as
  // is:inline and does not process/strip TypeScript — so this file is
  // intentionally plain JavaScript throughout, not TS-annotated.
  const params = new URLSearchParams(window.location.search);
  const subject = params.get('subject');
  const body = params.get('body');

  if (subject) {
    const subjectField = document.getElementById('subject');
    if (subjectField) subjectField.value = subject;
  }

  if (body) {
    const messageField = document.getElementById('message');
    if (messageField) messageField.value = body;
  }

  if (subject || body) {
    const interestField = document.getElementById('interest');
    if (interestField) interestField.value = 'existing-piece';
  }

  // Branded AJAX submission — keeps visitors on the Bartram Studio contact
  // page instead of redirecting to Formspree's hosted thank-you page (a
  // paid Formspree feature we're avoiding). Runs entirely client-side,
  // which fits the site's static output the same way the prefill logic above does.
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('contact-submit');
  const btnLabel = submitBtn ? submitBtn.querySelector('.btn-label') : null;
  const errorEl = document.getElementById('form-error');
  const successEl = document.getElementById('form-success');

  if (form && submitBtn && btnLabel) {
    let submitting = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      submitting = true;

      if (errorEl) {
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      btnLabel.textContent = 'Sending…';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        let result = null;
        try {
          result = await response.json();
        } catch (_) {
          // Formspree normally returns JSON when Accept: application/json is sent;
          // fall back to the HTTP status alone if the body isn't parseable.
        }

        if (response.ok && !(result && result.ok === false)) {
          form.hidden = true;
          if (successEl) {
            successEl.hidden = false;
            successEl.focus();
          }
        } else {
          const message =
            result && Array.isArray(result.errors)
              ? result.errors.map((e) => e && e.message).filter(Boolean).join(', ')
              : '';
          throw new Error(message || 'Submission failed');
        }
      } catch (_) {
        if (errorEl) {
          errorEl.textContent = `Something went wrong while sending your message. Please try again, or email me directly at ${contactEmail}.`;
          errorEl.hidden = false;
        }
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
        btnLabel.textContent = 'Send Message';
        submitting = false;
      }
    });
  }
</script>

<style>
/* Base .rich-text (p/strong/em/ul/ol/li/a) styling is centralized in
   src/styles/global.css — see the "Rich Text" section there for why. Only
   this page's own contextual rich-text override lives below (.faq-answer). */

.section-eyebrow {
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--secondary-text);
  margin-bottom: 0.6rem;
  max-width: none;
}

.contact-layout {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 4rem;
  align-items: start;
}

/* ── Form ── */
.contact-form-wrap h2 {
  color: var(--driftwood-dk);
  margin-bottom: 0.5rem;
}

.req { color: var(--coral); }

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.btn--submit {
  align-self: flex-start;
  gap: 0.6rem;
}

.btn--submit:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.form-error {
  font-size: 0.85rem;
  color: var(--coral);
  background: color-mix(in srgb, var(--coral) 10%, transparent);
  border: 1px solid var(--coral);
  border-radius: var(--radius);
  padding: 0.75rem 1rem;
  max-width: none;
}

.form-success {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  margin-top: 0.5rem;
  padding: 1.5rem;
  background: var(--sand);
  border: 1.5px solid var(--tide-light);
  border-radius: var(--radius);
  color: var(--driftwood-dk);
}

.form-success svg {
  flex-shrink: 0;
  color: var(--tide-dark);
  margin-top: 0.15rem;
}

.form-success__title {
  font-weight: 600;
  margin-bottom: 0.3rem;
  max-width: none;
}

.form-success__body {
  font-size: 0.92rem;
  color: var(--secondary-text);
  max-width: none;
}

.form-note {
  font-size: 0.75rem;
  color: var(--secondary-text);
  max-width: none;
  margin-top: -0.5rem;
}

/* ── Sidebar ── */
.contact-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.sidebar-card {
  background: var(--white);
  padding: 1.75rem;
  border: 1.5px solid var(--sand-dark);
  border-radius: var(--radius);
}

.sidebar-card--accent {
  background: var(--sand);
  border-color: var(--tide-light);
}

.sidebar-card h3 {
  font-size: 1.2rem;
  color: var(--driftwood-dk);
  margin-bottom: 1.1rem;
}

/* ── Contact Methods ── */
.contact-methods {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.contact-method {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
}

.contact-method__icon {
  width: 36px;
  height: 36px;
  background: var(--sand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--tide-dark);
}

.contact-method__label {
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--secondary-text);
  margin-bottom: 0.2rem;
  max-width: none;
}

.contact-method__value {
  font-size: 0.9rem;
  color: var(--driftwood-dk);
  text-decoration: none;
  transition: color 0.2s;
}

a.contact-method__value:hover { color: var(--tide-dark); }

.sidebar-response {
  margin-top: 1rem;
  font-size: 0.82rem;
  color: var(--secondary-text);
  max-width: none;
}

/* ── FAQs ── */
.faqs {
  display: flex;
  flex-direction: column;
}

.faq {
  border-bottom: 1px solid var(--sand-dark);
}

.faq:last-child { border-bottom: none; }

.faq summary {
  padding-block: 0.85rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--driftwood-dk);
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  user-select: none;
}

.faq summary::-webkit-details-marker { display: none; }

.faq summary::after {
  content: '+';
  font-size: 1.2rem;
  font-weight: 300;
  color: var(--tide);
  transition: transform 0.2s;
  flex-shrink: 0;
  margin-left: 1rem;
}

.faq[open] summary::after {
  transform: rotate(45deg);
}

/* faqItems[].answer is now Markdown-rendered and injected via set:html, so
   its <p> is not subject to Astro's scoped-style attribute — :global() is
   required here or this rule silently stops matching. */
.faq-answer :global(p) {
  padding-bottom: 1rem;
  font-size: 0.875rem;
  line-height: 1.7;
  margin: 0;
}

@media (max-width: 900px) {
  .contact-layout {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .form-row { grid-template-columns: 1fr; }
}
</style>
