---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { renderMarkdown } from '../../lib/richText';

const siteEntries = await getCollection('site');
const shop = siteEntries.find(e => e.id === 'shop.md')!.data;
const heroBgClass   = shop.heroBg    ? `bg-${shop.heroBg}`    : '';
const gridBgClass   = shop.shopGridBg? `bg-${shop.shopGridBg}`: '';
const shopCtaBgClass= shop.shopCtaBg ? `bg-${shop.shopCtaBg}` : '';

const allProducts = await getCollection('products');

// Sort: available first, then pending, then sold
const statusOrder = { available: 0, pending: 1, sold: 2 };
const sorted = [...allProducts].sort((a, b) => {
  const s = statusOrder[a.data.status] - statusOrder[b.data.status];
  if (s !== 0) return s;
  return a.data.title.localeCompare(b.data.title);
});

// ── Category display-name resolution ────────────────────────────────────────
// Products store either a new managed category's entry slug (e.g. "resin-art",
// the category's filename) or a legacy display name (e.g. "Resin Art",
// "Coastal Decor") left over from before the CMS Categories collection
// existed. This resolves either form to the category's current, editable
// display name, so a slug-stored product and a legacy-name-stored product in
// the same category group under one filter pill. If no managed category
// matches (a legacy/orphan value), the raw stored value is used as its own
// filter category rather than failing.
const categoryEntries = await getCollection('categories');
const categoryNameBySlug = new Map(categoryEntries.map(c => [c.slug, c.data.name]));
const categoryNameByName = new Map(categoryEntries.map(c => [c.data.name, c.data.name]));
function resolveCategoryName(raw: string): string {
  if (!raw) return raw;
  return categoryNameBySlug.get(raw) ?? categoryNameByName.get(raw) ?? raw;
}

// ── Stable filter-key resolution ────────────────────────────────────────────
// The Shop's filter pills and product cards need a stable key to match on
// (independent of the display label), so a homepage link built from a
// managed category's permanent slug always matches, even though the visible
// pill text is the friendly display name. Reverse lookup: managed display
// name -> managed slug, so legacy name-stored products resolve to the same
// key as slug-stored products in the same category.
const categorySlugByName = new Map(categoryEntries.map(c => [c.data.name, c.slug]));
function resolveCategoryKey(raw: string): string {
  if (!raw) return raw;
  if (categoryNameBySlug.has(raw)) return raw; // already a managed slug
  return categorySlugByName.get(raw) ?? raw;   // legacy display name -> managed slug, else orphan value stays its own key
}

// Filters carry both the stable key (for matching) and the friendly label
// (for display). Two sources are combined:
//  - every active managed category, so it has a pill even with zero products
//    (e.g. a homepage link to a category that has no products yet still works)
//  - every category actually represented by a product (covers inactive
//    managed categories still in use, and unmatched legacy/orphan values)
// Deduplicated by key and sorted alphabetically by label, preserving the
// previous visible alphabetical ordering.
const managedCategoryFilters = categoryEntries
  .filter(c => c.data.active === true)
  .map(c => ({ key: c.slug, label: c.data.name }));

const productCategoryFilters = allProducts.map(p => {
  const raw = p.data.category;
  const key = resolveCategoryKey(raw);
  const label = resolveCategoryName(raw);
  return { key, label };
});

const filters = [...new Map(
  [...managedCategoryFilters, ...productCategoryFilters].map(f => [f.key, f])
).values()].sort((a, b) => a.label.localeCompare(b.label));
---

<Layout
  title="Shop"
  description="Browse handcrafted resin shell art, coastal decor, seasonal crafts, and custom pieces by Amanda at Bartram Studio."
>

  <section class={`page-hero ${heroBgClass}`}>
    <div class="container">
      <p class="page-hero__eyebrow">{shop.pageEyebrow}</p>
      <h1>{shop.pageTitle}</h1>
      <div class="rich-text" set:html={renderMarkdown(shop.pageIntro)} />
    </div>
  </section>

  <section class={`section section--sm ${gridBgClass}`}>
    <div class="container">

      <!-- Filter Bar -->
      <div class="filter-bar">
        <div class="filter-bar__left">
          <p class="filter-bar__label">Filter by:</p>
          <div class="filter-pills" id="filter-pills">
            <button class="pill pill--active" data-category="all">All</button>
            {filters.map(category => (
              <button class="pill" data-category={category.key}>{category.label}</button>
            ))}
          </div>
        </div>
        <p class="filter-bar__count" id="count-label">{sorted.length} pieces</p>
      </div>

      <!-- Grid -->
      <div class="grid-3 products-grid" id="products-grid" style="margin-top: 2.5rem;">
        {sorted.map(product => (
          <a
            href={`/products/${product.slug}`}
            class="product-card"
            data-category={resolveCategoryKey(product.data.category)}
            style="text-decoration:none;"
          >
            <div class="product-card__img-wrap">
              {product.data.images && product.data.images.length > 0 ? (
                <img
                  src={product.data.images[0]}
                  alt={product.data.title}
                  loading="lazy"
                  onerror="this.parentElement.innerHTML='<div class=\'img-placeholder\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><polyline points=\'21 15 16 10 5 21\'/></svg></div>'"
                />
              ) : (
                <div class="img-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              )}
              {product.data.featured && (
                <span class="product-card__featured">Featured</span>
              )}
              <span class={`badge badge--${product.data.status} product-card__badge`}>
                {product.data.status === 'available' ? 'Available' : product.data.status === 'pending' ? 'Pending' : 'Sold'}
              </span>
            </div>
            <div class="product-card__body">
              <p class="product-card__category">{resolveCategoryName(product.data.category)}</p>
              <h2 class="product-card__title">{product.data.title}</h2>
              <p class="product-card__price">${product.data.price}</p>
            </div>
            <div class="product-card__footer">
              {product.data.status === 'available' ? (
                <span class="btn btn--primary" style="width:100%;justify-content:center;">View Details</span>
              ) : (
                <span class="btn btn--ghost" style="width:100%;justify-content:center;">
                  {product.data.status === 'pending' ? 'Pending Sale' : 'Sold'}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>

      <!-- Empty state -->
      <div id="empty-state" style="display:none; text-align:center; padding: 4rem 0;">
        <p style="font-family: var(--font-display); font-size: 1.5rem; font-style: italic; color: var(--driftwood);">No pieces in this category yet.</p>
        <p style="margin-top: 0.5rem;">Check back soon, or <a href="/contact" style="color: var(--tide-dark);">inquire about a custom order</a>.</p>
      </div>

    </div>
  </section>

  <!-- Custom CTA -->
  <section class={`section--sm shop-cta ${shopCtaBgClass}`}>
    <div class="container" style="text-align:center;">
      <p style="font-family: var(--font-display); font-size: 1.5rem; font-style: italic; color: var(--driftwood-dk); margin-bottom: 0.5rem;">Don't see exactly what you're looking for?</p>
      <p style="margin-bottom: 1.5rem; margin-inline: auto;">Custom orders are always welcome. Reach out to start a conversation.</p>
      <a href="/contact" class="btn btn--coral">Request a Custom Piece</a>
    </div>
  </section>

</Layout>

<style>
/* ── Rich text (Markdown-rendered fields) ────────────────────────────────
   Content here is injected via set:html and is NOT covered by Astro's
   automatic style scoping, so these selectors use :global() deliberately —
   without it, none of them would match the rendered output. Colours are
   inherited so this drops into any existing text container unchanged.
   pageIntro sits inside .page-hero, whose own paragraph styling (if any)
   lives in global.css rather than this page's scoped block, so it already
   applies to injected content without needing a :global() fix here. */
.rich-text :global(p) { margin: 0 0 0.6em; }
.rich-text :global(p:last-child) { margin-bottom: 0; }
.rich-text :global(strong) { font-weight: 600; }
.rich-text :global(em) { font-style: italic; }
.rich-text :global(ul),
.rich-text :global(ol) {
  margin: 0 0 0.6em 1.25em;
  padding: 0;
}
.rich-text :global(li) { margin-bottom: 0.3em; }
.rich-text :global(li:last-child) { margin-bottom: 0; }
.rich-text :global(a) {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 0.15em;
}

/* Hero subtitle (shop.pageIntro) was rendering left-aligned — .page-hero's
   own centering (in global.css) applies to specific known children like
   .page-hero__eyebrow and h1, but not to this rich-text wrapper, which
   didn't exist until the Markdown-rendering feature added it. */
.page-hero .rich-text {
  text-align: center;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--sand-dark);
}

.filter-bar__left {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.filter-bar__label {
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--driftwood);
  max-width: none;
  white-space: nowrap;
}

.filter-bar__count {
  font-size: 0.8rem;
  color: var(--driftwood);
  white-space: nowrap;
  max-width: none;
}

.filter-pills {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.pill {
  padding: 0.35rem 0.9rem;
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  font-family: var(--font-body);
  text-transform: uppercase;
  border: 1.5px solid var(--sand-dark);
  background: transparent;
  color: var(--driftwood);
  cursor: pointer;
  border-radius: 20px;
  transition: all 0.2s;
}

.pill:hover {
  border-color: var(--tide);
  color: var(--tide-dark);
}

.pill--active {
  background: var(--tide-dark);
  border-color: var(--tide-dark);
  color: var(--white);
}

.product-card[data-hidden] {
  display: none;
}

.shop-cta {
  background: var(--sand);
  padding-block: 3rem;
}

/* The CTA paragraphs above already center correctly via the existing
   inline text-align: center on .shop-cta .container. margin-inline: auto
   is a no-op on an inline-level element (the likely case here, matching
   other .btn usage sitewide), so this only takes effect — centering the
   button — if .btn ever renders as a block-level box. */
.shop-cta a.btn {
  margin-inline: auto;
}
</style>

<script>
const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
const cards = document.querySelectorAll<HTMLElement>('.product-card');
const emptyState = document.getElementById('empty-state');
const countLabel = document.getElementById('count-label');

// Single reusable filter routine: sets the active pill, shows/hides product
// cards, and updates the count and empty-state display for a given category key.
function applyFilter(categoryKey: string) {
  pills.forEach(p => p.classList.toggle('pill--active', p.dataset.category === categoryKey));

  let visible = 0;
  cards.forEach(card => {
    const match = categoryKey === 'all' || card.dataset.category === categoryKey;
    card.toggleAttribute('data-hidden', !match);
    if (match) visible++;
  });

  if (countLabel) countLabel.textContent = `${visible} piece${visible !== 1 ? 's' : ''}`;
  if (emptyState) emptyState.style.display = visible === 0 ? 'block' : 'none';
}

// Attach pill click listeners first so manual filtering keeps working exactly
// as before. Clicking a pill never touches the URL.
pills.forEach(pill => {
  pill.addEventListener('click', () => {
    applyFilter(pill.dataset.category ?? 'all');
  });
});

// Only after listeners are attached, apply a category from the URL param.
// If no pill matches, leave the default All state (already active in markup)
// rather than showing an empty page for an invalid category.
const urlCat = new URLSearchParams(window.location.search).get('category');
if (urlCat) {
  const matchingPill = Array.from(pills).find(p => p.dataset.category === urlCat);
  if (matchingPill) {
    applyFilter(urlCat);
  }
}
</script>
